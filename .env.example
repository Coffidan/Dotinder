# Пример переменных окружения для Dotinder.
# Скопируйте в .env и заполните реальными значениями. НЕ коммитьте .env в git.

# --- Подключение backend к базе данных (Spring datasource) ---
DB_URL=jdbc:postgresql://localhost:5432/dotinder_db
DB_USER=user
DB_PASSWORD=password

# --- JWT (подпись токенов) ---
# Обязательно замените на длинный случайный секрет в проде.
JWT_SECRET=someVeryLongAndRandomSecretKey1234567890-Change-In-Production

# --- Steam API (Steam Web API key) ---
# Получить: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# --- OpenDota API ---
# Получить: https://www.opendota.com/api-keys
OPENDOTA_API_KEY=

# --- Postgres (docker-compose) ---
POSTGRES_DB=dotinder_db
POSTGRES_USER=user
POSTGRES_PASSWORD=password
